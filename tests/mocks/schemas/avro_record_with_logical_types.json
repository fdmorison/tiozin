    {
      "name": "amount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 10,
        "scale": 2
      }
    },
    {
      "name": "status",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "events.status",
